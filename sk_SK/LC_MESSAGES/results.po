msgid "Co to znamená?"
msgstr "Čo to znamená?"

msgctxt "player.ranking.elo"
msgid "Hodnota blízká 100% znamená definitivní výhru.<br>Hodnota blízká 50% je remíza (totožná herní úroveň).<br>Hodnota 0% je definitivní prohra."
msgstr "Hodnota blízka 100 % je definitívna výhra.<br>Hodnota blízka 50 % je remíza (identická úroveň hry).<br>Hodnota 0 % je definitívna prehra."

msgctxt "player.ranking.elo"
msgid "Koeficient výhry"
msgstr "LAC môžu mať niektoré varianty LAC, ktoré môžu chýbať."

msgctxt "player.ranking.elo"
msgid "Hodnota vypočítaná podle toho, jak jsou hráči vyrovnaní. Výsledná hodnota násobí počet bodů."
msgstr "Hodnota vypočítaná na základe toho, ako sú hráči vyrovnaní. Výsledná hodnota sa vynásobí počtom bodov."

